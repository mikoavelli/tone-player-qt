# Doxygen configuration for tone-player-qt.
# Run "just docs" (or "doxygen Doxyfile") to generate HTML into build/doxygen.

PROJECT_NAME           = "TonePlayer"
PROJECT_BRIEF          = "Control-tone player with an equalizer"
OUTPUT_DIRECTORY       = build/doxygen

INPUT                  = src README.md
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
EXCLUDE                = build build-dev build-san
EXCLUDE_PATTERNS       = */build*/*

EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
EXTRACT_PRIVATE        = NO
JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
HAVE_DOT               = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
