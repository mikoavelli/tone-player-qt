{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build (-O2, LTO)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TONE_PLAYER_LANGUAGE": "en",
        "TONE_PLAYER_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Unoptimized development build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TONE_PLAYER_LANGUAGE": "en",
        "TONE_PLAYER_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "san",
      "displayName": "Debug + ASan/UBSan",
      "description": "Debug build with address and undefined behavior sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-san",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TONE_PLAYER_LANGUAGE": "en",
        "TONE_PLAYER_WARNINGS_AS_ERRORS": "ON",
        "TONE_PLAYER_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "san",
      "configurePreset": "san"
    }
  ]
}
